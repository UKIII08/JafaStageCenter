# Jonathan App — produkcja. Caddy sam wyrabia i odnawia certyfikaty HTTPS.
jonathanapp.com {
    reverse_proxy app:8000
}

# www -> domena główna
www.jonathanapp.com {
    redir https://jonathanapp.com{uri} permanent
}

