# Skopiuj do deploy/.env i uzupełnij. NIE commituj pliku .env!
SECRET_KEY=wygeneruj-dlugi-losowy-ciag-min-32-znaki
DB_PASSWORD=wygeneruj-losowe-haslo-do-bazy
# E-maile (Brevo free — RUNBOOK krok 3); puste = maile tylko w logu
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="JafaStage <no-reply@twojadomena.pl>"
# Monitoring błędów (RUNBOOK krok 6); puste = wyłączone
SENTRY_DSN=

# Integracja z JafaApp (Jafa Warszawa). Ten sam sekret ustaw w JafaApp jako JONATHAN_SECRET
# (min. 32 znaki: openssl rand -hex 32). JAFA_CHURCH_ID = id wspólnoty Jafa (adres /c/<id> w panelu).
# Puste = integracja wyłączona.
JAFA_SECRET=
JAFA_CHURCH_ID=
